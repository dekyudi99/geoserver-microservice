# Service Settings
PORT=8001
HOST=0.0.0.0
DEBUG=True
API_KEY=secret_geoserver_s2s_key

# GeoServer REST Configuration
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASS=geoserver
GEOSERVER_WMS_URL=http://localhost:8080/geoserver

# PostGIS GeoServer DB (Spatial Database)
POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=geoserver_db
POSTGIS_USER=postgres
POSTGIS_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geoserver_db

# File Storage Paths
DATA_RASTER_PATH=/data_raster
DATA_VECTOR_PATH=/data_vector

# Processing Settings
SIMPLIFY_TOLERANCE=0.0001
