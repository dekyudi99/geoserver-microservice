# ==========================================
# GeoServer Engine Container (kartoza/geoserver)
# ==========================================
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=rahasia
INITIAL_MEMORY=2G
MAXIMUM_MEMORY=4G

# ==========================================
# GeoServer Microservice Settings
# ==========================================
PORT=8001
HOST=0.0.0.0
DEBUG=True

# GeoServer REST Configuration
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASS=rahasia
GEOSERVER_WMS_URL=http://localhost:8080/geoserver

# PostGIS Database Connection
POSTGIS_HOST=db
POSTGIS_PORT=5432
POSTGIS_DB=spasial_db
POSTGIS_USER=postgres
POSTGIS_PASSWORD=rahasia
DATABASE_URL=postgresql://postgres:rahasia@db:5432/spasial_db

# File Storage Paths
DATA_RASTER_PATH=/data_raster
DATA_VECTOR_PATH=/data_vector

# Processing Settings
SIMPLIFY_TOLERANCE=0.0001
