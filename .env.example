# ==========================================
# PostGIS Spatial Database (postgis_geoserver)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rahasia
POSTGRES_DB=geoserver_spatial_db

# ==========================================
# GeoServer Engine Container (kartoza/geoserver)
# ==========================================
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=rahasia
INITIAL_MEMORY=2G
MAXIMUM_MEMORY=4G

# ==========================================
# GeoServer Microservice FastAPI Settings
# ==========================================
PORT=8001
HOST=0.0.0.0
DEBUG=True

# GeoServer REST Configuration
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASS=rahasia
GEOSERVER_WMS_URL=http://localhost:8080/geoserver

# PostGIS Connection (Internal Docker Network)
POSTGIS_HOST=postgis_geoserver
POSTGIS_PORT=5432
POSTGIS_DB=geoserver_spatial_db
POSTGIS_USER=postgres
POSTGIS_PASSWORD=rahasia
DATABASE_URL=postgresql://postgres:rahasia@postgis_geoserver:5432/geoserver_spatial_db

# File Storage Paths
DATA_RASTER_PATH=/data_raster
DATA_VECTOR_PATH=/data_vector

# Processing Settings
SIMPLIFY_TOLERANCE=0.0001
