# ==========================================
# Central Database 1: Auth & User Metadata (voxagis_user)
# ==========================================
DB_HOST=db-central-postgres
DB_PORT=5432
DB_NAME=voxagis_user
DB_USER=voxagis_app
DB_PASSWORD=your_voxagis_user_password
DATABASE_URL=postgresql://voxagis_app:your_voxagis_user_password@db-central-postgres:5432/voxagis_user

# ==========================================
# Central Database 2: Spatial PostGIS & GeoServer Datastore (spatial)
# ==========================================
SPATIAL_DB_HOST=db-central-postgres
SPATIAL_DB_PORT=5432
SPATIAL_DB_NAME=spatial
SPATIAL_DB_USER=geoserver_svc
SPATIAL_DB_PASSWORD=your_spatial_password
SPATIAL_DATABASE_URL=postgresql://geoserver_svc:your_spatial_password@db-central-postgres:5432/spatial

# GeoServer PostGIS Connection (Internal Docker Network)
POSTGIS_HOST=db-central-postgres
POSTGIS_PORT=5432
POSTGIS_DB=spatial
POSTGIS_USER=geoserver_svc
POSTGIS_PASSWORD=your_spatial_password

# File Storage Paths
DATA_RASTER_PATH=/data_raster
DATA_VECTOR_PATH=/data_vector

# Processing Settings
SIMPLIFY_TOLERANCE=0.0001

# ==========================================
# API Key & Security Settings
# ==========================================
API_KEY=rahasia_s2s_geoserver_key_2026
